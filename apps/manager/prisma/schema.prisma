// This is your Prisma schema file for the SaaS Manager
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

/// Business vertical types (future-proofing for expansion)
enum BusinessType {
  RETAIL   // E-commerce stores (current focus)
  SERVICE  // Service booking (future: salons, consultants)
  BOOKING  // Appointment scheduling (future: hotels, events)
}

/// Tenant status
enum TenantStatus {
  ACTIVE    // Active and operational
  TRIAL     // Trial period
  SUSPENDED // Temporarily suspended
  CANCELLED // Subscription cancelled
}

/// User roles
enum UserRole {
  SUPER_ADMIN   // Platform owner (HQ)
  TENANT_ADMIN  // Merchant owner
  TENANT_STAFF  // Merchant team member
  CUSTOMER      // End customer
}

/// License status
enum LicenseStatus {
  ACTIVE  // License is active
  EXPIRED // License has expired
  REVOKED // License was revoked
}

/// Email template types
enum EmailType {
  VERIFICATION
  WELCOME
  PASSWORD_RESET
  ORDER_CONFIRMATION
  ORDER_SHIPPED
  ORDER_CANCELLED
}

/// Subscription plan types
enum PlanType {
  BASIC
  PRO
  ENTERPRISE
}

/// Subscription status (synced with Stripe)
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}

/// Payment status
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ============================================
// MODELS
// ============================================

/// Tenant (Merchant) - Each tenant has their own store
model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  domain    String?      @unique // Custom domain (optional)
  type      BusinessType @default(RETAIL)
  status    TenantStatus @default(TRIAL)

  // Vendure Integration
  vendureChannelId    String? @unique
  vendureChannelToken String? @unique

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  license          License?
  users            TenantUser[]
  emailSettings    TenantEmailSettings?
  emailTemplates   EmailTemplate[]
  
  // Payment Relations (Per-Tenant Isolation)
  paymentSettings  TenantPaymentSettings?
  subscription     Subscription?
  payments         Payment[]

  @@map("tenants")
}

/// License for each tenant
model License {
  id        String        @id @default(cuid())
  key       String        @unique
  status    LicenseStatus @default(ACTIVE)
  expiresAt DateTime?
  
  // Plan info
  planId    String?
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastUsedAt  DateTime?

  // Relations
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

/// Users (can belong to multiple tenants)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(CUSTOMER)
  isActive     Boolean  @default(true)

  // Email Verification
  emailVerified            Boolean   @default(false)
  verificationToken        String?   @unique
  verificationTokenExpiry  DateTime?

  // Password Reset
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  // Login tracking
  lastLoginAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenants  TenantUser[]
  sessions Session[]

  @@index([email])
  @@index([role])
  @@map("users")
}

/// Session for JWT token management
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token        String   @unique
  refreshToken String?  @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Metadata
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

/// Junction table for User-Tenant relationship
model TenantUser {
  id       String   @id @default(cuid())
  role     UserRole @default(TENANT_STAFF)
  joinedAt DateTime @default(now())

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("tenant_users")
}

/// Audit logs for security and debugging
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entityType String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  
  // Relations
  userId    String?
  tenantId  String?
  
  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// EMAIL SYSTEM
// ============================================

/// Email settings per tenant
model TenantEmailSettings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // SMTP Configuration
  smtpHost      String   @default("smtp.gmail.com")
  smtpPort      Int      @default(587)
  smtpUser      String?
  smtpPass      String?  // Encrypted
  smtpSecure    Boolean  @default(false)
  
  // Email Identity
  fromName      String   @default("My Store")
  fromEmail     String?
  replyToEmail  String?
  
  // Policies
  requireEmailVerification  Boolean @default(false)
  blockTempEmails           Boolean @default(true)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_email_settings")
}

/// Email templates per tenant
model EmailTemplate {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  type      EmailType
  subject   String
  bodyHtml  String
  bodyText  String?
  
  isActive  Boolean   @default(true)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([tenantId, type])
  @@map("email_templates")
}

/// Blocked email domains (temp mail protection)
model BlockedEmailDomain {
  id        String   @id @default(cuid())
  domain    String   @unique  // e.g., "mailinator.com"
  reason    String?
  isGlobal  Boolean  @default(true)  // Apply to all tenants
  tenantId  String?  // If not global, specific tenant
  
  createdAt DateTime @default(now())

  @@map("blocked_email_domains")
}

/// Email logs for tracking
model EmailLog {
  id        String   @id @default(cuid())
  tenantId  String
  
  type      EmailType
  toEmail   String
  subject   String
  status    String   @default("sent")  // sent, failed, bounced
  errorMsg  String?
  
  // Timestamps
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([toEmail])
  @@index([createdAt])
  @@map("email_logs")
}

// ============================================
// PAYMENT SYSTEM (Per-Tenant Isolation)
// ============================================

/// Payment methods available
enum PaymentMethodType {
  VISA_MASTERCARD   // Credit/Debit cards
  INSTAPAY          // Egypt InstaPay
  VODAFONE_CASH     // Vodafone Cash
  ORANGE_CASH       // Orange Cash
  ETISALAT_CASH     // Etisalat Cash
  FAWRY             // Fawry payments
  BANK_TRANSFER     // Direct bank transfer
  CASH_ON_DELIVERY  // COD
}

/// Payment settings per tenant (COMPLETE ISOLATION)
model TenantPaymentSettings {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // ============ Card Payments (Visa/Mastercard) ============
  cardEnabled       Boolean @default(false)
  cardProvider      String? // "stripe", "paymob", "fawry_cards"
  cardApiKey        String? // Encrypted
  cardSecretKey     String? // Encrypted
  cardWebhookSecret String? // Encrypted
  
  // ============ InstaPay ============
  instapayEnabled   Boolean @default(false)
  instapayAccount   String? // Account number/username
  instapayApiKey    String? // If API available
  
  // ============ E-Wallets ============
  vodafoneCashEnabled  Boolean @default(false)
  vodafoneCashNumber   String? // Wallet number
  
  orangeCashEnabled    Boolean @default(false)
  orangeCashNumber     String?
  
  etisalatCashEnabled  Boolean @default(false)
  etisalatCashNumber   String?
  
  // ============ Fawry ============
  fawryEnabled      Boolean @default(false)
  fawryMerchantId   String? // Encrypted
  fawrySecretKey    String? // Encrypted
  
  // ============ Bank Transfer ============
  bankTransferEnabled  Boolean @default(false)
  bankName             String?
  bankAccountName      String?
  bankAccountNumber    String? // Encrypted
  bankIban             String? // Encrypted
  
  // ============ Cash on Delivery ============
  codEnabled           Boolean @default(true) // Usually enabled by default
  codExtraFee          Int      @default(0)   // Extra fee in cents
  
  // ============ General Settings ============
  defaultCurrency      String   @default("EGP")
  testMode             Boolean  @default(true) // Test mode for development
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_payment_settings")
}

/// Subscription (for SaaS billing - Super Admin collects from Tenants)
model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Stripe Integration (for SaaS billing)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  stripeCustomerId     String?
  
  // Plan Details
  plan                 PlanType           @default(BASIC)
  status               SubscriptionStatus @default(TRIALING)
  
  // Billing Cycle
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAt             DateTime?
  canceledAt           DateTime?
  
  // Timestamps
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

/// Payments (both customer payments and SaaS billing)
model Payment {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  
  // Payment Details
  amount                Int           // Amount in smallest currency unit (cents/piastres)
  currency              String        @default("EGP")
  status                PaymentStatus @default(PENDING)
  method                PaymentMethodType?
  
  // External References
  externalPaymentId     String?       @unique // ID from payment provider
  externalInvoiceId     String?
  
  // Order Reference (for customer payments)
  orderId               String?       // Vendure Order ID
  orderCode             String?       // Vendure Order Code
  
  // Metadata
  metadata              Json?
  failureReason         String?
  
  // Timestamps
  createdAt             DateTime      @default(now())
  paidAt                DateTime?

  @@index([tenantId])
  @@index([externalPaymentId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

/// Webhook event tracking (IDEMPOTENCY - Prevents double processing)
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique  // External event ID (e.g., Stripe event.id)
  eventType   String             // e.g., "payment_intent.succeeded"
  provider    String             // "stripe", "paymob", "fawry"
  tenantId    String?            // If tenant-specific
  
  // Event Data (for debugging)
  data        Json?
  
  // Timestamps
  processedAt DateTime @default(now())

  @@index([eventId])
  @@index([eventType])
  @@index([provider])
  @@index([tenantId])
  @@map("processed_webhook_events")
}

