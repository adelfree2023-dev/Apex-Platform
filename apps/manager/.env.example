# Manager API Environment Variables

# Database (SaaS DB - Port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apex_saas

# Vendure Connection
VENDURE_URL=http://localhost:3001/admin-api
VENDURE_SUPERADMIN_USERNAME=superadmin
VENDURE_SUPERADMIN_PASSWORD=superadmin

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
